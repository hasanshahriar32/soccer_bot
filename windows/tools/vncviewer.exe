    <script id="jf-load-gtm">
        function loadGTM() {
            initGTM();
            addDevId();
            addInteractionEvent();

            function initGTM() {

                if (window.gtmDidInit) {
                    return false;
                }
                window.gtmDidInit = true;

                (function (w, d, s, l, i) {
                    w[l] = w[l] || [];
                    w[l].push({
                        'gtm.start':
                            new Date().getTime(), event: 'gtm.js'
                    });
