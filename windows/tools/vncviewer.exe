<script>
    document.addEventListener('scroll', initNagichOnEvent);
    document.addEventListener('mousemove', initNagichOnEvent);
    document.addEventListener('touchstart', initNagichOnEvent);
    document.addEventListener("keydown",initNagichOnEvent);


    function initNagichOnEvent (event) {
        initNagich();
        event.currentTarget.removeEventListener(event.type, initNagichOnEvent);
    }

    function initNagich() {
        if (window.nagichDidInit) {
            return false;
        }
        window.nagichDidInit = true;

        (function(doc, head, body){
            var coreCall             = doc.createElement('script');
            coreCall.src             = interdeal.domains.js + 'core/5.0.9/accessibility.js';
            coreCall.defer           = true;
            coreCall.integrity       = 'sha512-dxjHZQgpVIG70EQus4+1KR3oj2KGyrtwR/nr4lY+tcMjrQ1Yb9V1SCKNVLGhD3CcPMgANKAqOk4ldI8WWNnQTw==';
            coreCall.crossOrigin     = 'anonymous';
            coreCall.setAttribute('data-cfasync', true );
            body? body.appendChild(coreCall) : head.appendChild(coreCall);
        })(document, document.head, document.body);

        document.querySelector('.accessibility-mode')?.addEventListener('click', function() {
            window.interdeal.a11y.openMenu();
        });
    }
</script>

<script>
(function () {
  'use strict';
  var CONFIG = {

    /** 'us_eu_default' = US link, EU link, else default link.
     *  'eu_vs_rest'    = EU link, everyone else gets default link (ignores US list).
     */
    mode: 'us_eu_default',

    /** Timeouts / polling */
    pollMs: 500,
    timeoutMs: 10000,

    /** Banner root in the DOM */
    bannerId: 'topFixedStripeOuter',

    /** URLs — swap these anytime */
    urls: {
      us: 'https://swampup.jfrog.com/',
      eu: 'https://swampup.jfrog.com/europe/',
      default: 'https://swampup.jfrog.com/all-events/',
    },

    /** Marker URL — script only runs if at least one anchor in the banner contains this */
    markerUrl: 'https://swampup.jfrog.com/',

    /**
     * Country lists — ISO-ish codes, uppercase recommended.
     * EU list: keep as one comma-separated string for quick edits.
     */
    regions: {
      usCountries: 'US',
      euCountries:
        'AE,AG,AO,AT,BA,BE,BG,BY,CH,CZ,DE,DK,EE,EG,ES,ET,FI,FR,GB,GH,GR,HU,IE,IL,IS,IT,JO,KE,KW,LB,LI,LU,LV,LY,MA,MD,MT,NL,NO,OM,PL,PT,QA,RO,SA,SE,SI,SK,SM,SZ,SY,TN,TR,UA,UG,VA,ZA,ZM,ZW',
    },

    /**
     * data-gal: set to false to leave existing data-gal untouched.
     * Or use 'url' to mirror href, or 'labels' for short GA-style strings.
     */
    dataGal: {
      strategy: 'labels', // 'off' | 'url' | 'labels'
      labels: {
        us: 'Swamp Up — US',
        eu: 'Swamp Up — Europe',
        default: 'Swamp Up — All events',
      },
    },
  };
  /** ========== END CONFIG ========== */

  function parseCountrySet(csv) {
    var set = {};
    csv.split(',').forEach(function (c) {
      var code = String(c).trim().toUpperCase();
      if (code) set[code] = true;
    });
    return set;
  }

  function normalizeCountry(code) {
    return code ? String(code).trim().toUpperCase() : '';
  }

  var US = parseCountrySet(CONFIG.regions.usCountries);
  var EU = parseCountrySet(CONFIG.regions.euCountries);

  function resolveUrl(countryCode) {
    var code = normalizeCountry(countryCode);

    if (CONFIG.mode === 'eu_vs_rest') {
      return EU[code] ? CONFIG.urls.eu : CONFIG.urls.default;
    }

    // us_eu_default
    if (US[code]) return CONFIG.urls.us;
    if (EU[code]) return CONFIG.urls.eu;
    return CONFIG.urls.default;
  }

  function resolveDataGal(countryCode, targetUrl, segment) {
    var dg = CONFIG.dataGal || {};
    if (!dg.strategy || dg.strategy === 'off') return null;

    if (dg.strategy === 'url') return targetUrl;

    if (dg.strategy === 'labels' && dg.labels) {
      if (segment === 'us') return dg.labels.us;
      if (segment === 'eu') return dg.labels.eu;
      return dg.labels.default;
    }

    return null;
  }

  function segmentForCountry(countryCode) {
    var code = normalizeCountry(countryCode);

    if (CONFIG.mode === 'eu_vs_rest') {
      return EU[code] ? 'eu' : 'default';
    }

    if (US[code]) return 'us';
    if (EU[code]) return 'eu';
    return 'default';
  }

  function bannerHasMarkerUrl(root) {
    var anchors = root.querySelectorAll('a[href]');
    for (var i = 0; i < anchors.length; i++) {
      var href = anchors[i].getAttribute('href') || '';
      if (href.indexOf(CONFIG.markerUrl) !== -1) {
        return true;
      }
    }
    return false;
  }

  function applyBanner(countryCode) {
    var root = document.getElementById(CONFIG.bannerId);
    if (!root) return false;

    // If the banner doesn't contain the SwampUp URL, leave everything as-is.
    if (!bannerHasMarkerUrl(root)) return true;

    var segment = segmentForCountry(countryCode);
    var url = resolveUrl(countryCode);
    var gal = resolveDataGal(countryCode, url, segment);

    var anchors = root.querySelectorAll('a[href]');
    for (var i = 0; i < anchors.length; i++) {
      var a = anchors[i];
      a.setAttribute('href', url);

      if (gal != null && a.hasAttribute('data-gal')) {
        a.setAttribute('data-gal', gal);
      }
    }

    return true;
  }

  function waitForCountryAndBanner() {
    var start = Date.now();

    function tick() {
      var hasGeo =
        typeof jfrog_general !== 'undefined' &&
        jfrog_general &&
        jfrog_general.location &&
        jfrog_general.location.country;

      if (hasGeo) {
        if (applyBanner(jfrog_general.location.country)) return;
      }

      if (Date.now() - start > CONFIG.timeoutMs) {
        if (typeof console !== 'undefined' && console.warn) {
          console.warn(
            '[SwampUp banner] Timeout waiting for geo and/or #' + CONFIG.bannerId
          );
        }
        return;
      }

      setTimeout(tick, CONFIG.pollMs);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', tick);
    } else {
      tick();
    }
  }

  waitForCountryAndBanner();
})();
</script><script>
  const jfFormExists = document.getElementsByClassName('JFROG-CAPTCHA');
  if ((jfFormExists.length > 0) && (jfrog_general.is_china != 1 || true)) {
    setTimeout(function () {
      console.log('loading.recaptcha');
      let grecap = document.createElement('script')
      grecap.src = 'https://www.recaptcha.net/recaptcha/api.js?onload=CaptchaCallback&render=explicit&ver=5.5.1'
      grecap.type = 'text/javascript'
      grecap.id = 'google_recapcha-js'
      grecap.async = true
      grecap.defer = true
      document.body.appendChild(grecap); // add to bottom of body

      // Useful when CaptchaCallback function is not called on load in mobile browsers only
      if (/Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)) {
        document.addEventListener('scroll', reCaptchaInitialisationMobile);
        document.addEventListener('mousemove', reCaptchaInitialisationMobile);
        document.addEventListener('touchstart', reCaptchaInitialisationMobile);
      }
    }, 4000);
  }

  function reCaptchaInitialisationMobile() {
    console.log('reCaptchaInitialisationMobile');
    setTimeout(function () {
      if (!jfrog_general.jf_reCaptchaInitialisationMobile) {
        window.CaptchaCallback();
      }
    }, 1000);

    event.currentTarget.removeEventListener('scroll', reCaptchaInitialisationMobile);
    event.currentTarget.removeEventListener('mousemove', reCaptchaInitialisationMobile);
    event.currentTarget.removeEventListener('touchstart', reCaptchaInitialisationMobile);
  }
</script>

  </body>
