                        'https://gtm.jfrog.com/gtm.js?id=' + i + dl;
                    f.parentNode.insertBefore(j, f);
                })(window, document, 'script', 'dataLayer', 'GTM-T6MF8M');

            }

            function addDevId() {
              window.dataLayer = window.dataLayer || [];

              function gtag() {
                dataLayer.push(arguments);
              }

              gtag("js", new Date());
              gtag("config", "GTM-T6MF8M");
              gtag('set', 'developer_id.dODQ2Mj', true);
            }

            function addInteractionEvent() {
                window.dataLayer = window.dataLayer || [];

                var interactionEvents = ['scroll', 'mousemove', 'touchstart'];
                var hasPushedEvent = false;

                function pushInteractionEvent(eventType) {
                    if (hasPushedEvent) {
                        return;
                    }

                    hasPushedEvent = true;
                    window.dataLayer.push({
                        event: 'firstInteraction',
                        interaction_type: eventType
                    });

                    interactionEvents.forEach(function (interactionEvent) {
                        window.removeEventListener(interactionEvent, interactionHandler);
                    });
                }

                function interactionHandler(event) {
                    pushInteractionEvent(event.type);
                }

                interactionEvents.forEach(function (interactionEvent) {
                    window.addEventListener(interactionEvent, interactionHandler, { passive: true });
                });
            }
        }

        if (typeof window.jfrogConsent?.addAirgapCallback === "function") window.jfrogConsent.addAirgapCallback(loadGTM);
    </script>
  
